{
  "name": "kaderblick-analyse-player",
  "version": "2.9.0",
  "description": "Desktop player for football video analysis with CSV segments, live filters and team-friendly controls.",
  "desktopName": "de.fussballverein.video-player",
  "main": "out/main/index.js",
  "author": {
    "name": "Andreas Kempe",
    "email": "andreas.kempe@byte-artist.de",
    "url": "https://kaderblick.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mastercad/Kaderblick-Analyse-Player.git"
  },
  "homepage": "https://github.com/mastercad/Kaderblick-Analyse-Player",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:clean-unpacked && tsc --noEmit && electron-vite build && electron-builder --publish never",
    "build:dir": "npm run build:clean-unpacked && tsc --noEmit && electron-vite build && electron-builder --dir",
    "build:clean-unpacked": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const dir of ['release/linux-unpacked', 'release/win-unpacked']) { rmSync(dir, { recursive: true, force: true }); }\"",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "de.fussballverein.video-player",
    "productName": "Kaderblick Analyse Player",
    "artifactName": "kaderblick-analyse-player-${version}-${os}-${arch}.${ext}",
    "executableName": "kaderblick-analyse-player",
    "asar": {
      "unpack": [
        "node_modules/ffmpeg-static/**/*",
        "node_modules/ffprobe-static/**/*"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "mastercad",
      "repo": "Kaderblick-Analyse-Player",
      "releaseType": "release"
    },
    "extraMetadata": {
      "description": "Kaderblick Analyse Player für gemeinsame Videoanalyse im Team"
    },
    "icon": "assets/kaderblick_analyse_player_appicon.svg",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "assets/kaderblick_analyse_player_appicon.svg",
      "desktop": {
        "entry": {
          "Name": "Kaderblick Analyse Player",
          "Comment": "CSV-basierte Videoanalyse mit Segmentmodus, Filtern und Presets",
          "StartupWMClass": "Kaderblick Analyse Player"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/kaderblick_player_appicon.icns",
      "sign": {
        "identity": null
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/kaderblick_player_appicon.ico",
      "legalTrademarks": "Kaderblick Analyse Player"
    },
    "portable": {
      "artifactName": "kaderblick-analyse-player-portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Kaderblick Analyse Player",
      "uninstallDisplayName": "Kaderblick Analyse Player",
      "installerIcon": "assets/kaderblick_player_appicon.ico",
      "uninstallerIcon": "assets/kaderblick_player_appicon.ico",
      "installerHeaderIcon": "assets/kaderblick_player_appicon.ico",
      "artifactName": "kaderblick-analyse-player-setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "mp4box": "^2.4.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^41.10.7",
    "electron-builder": "27.0.0-alpha.10",
    "electron-vite": "^4.0.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lodash.isequal": "npm:@lodash-modularized/isequal@^1.0.1"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
